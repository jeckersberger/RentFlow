# =============================================================================
# CrateDesk — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
# Benutzername fuer die Datenbank
POSTGRES_USER=cratedesk
# Passwort fuer PostgreSQL (MUSS gesetzt werden!)
POSTGRES_PASSWORD=changeme_postgres_secret
# Externer Port (Standard: 5432)
POSTGRES_PORT=5432

# --- Redis ---
# Passwort fuer Redis (MUSS gesetzt werden!)
REDIS_PASSWORD=changeme_redis_secret
# Externer Port (Standard: 6379)
REDIS_PORT=6379

# --- Traefik ---
# Log-Level: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
# HTTP-Port (Standard: 80)
TRAEFIK_HTTP_PORT=80
# HTTPS-Port (Standard: 443)
TRAEFIK_HTTPS_PORT=443
# Dashboard-Port (Standard: 8080)
TRAEFIK_DASHBOARD_PORT=8080

# --- JWT / Auth ---
# RS256 Private Key Pfad (relativ zum auth-service)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
# RS256 Public Key Pfad
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Access-Token Lebensdauer in Minuten
JWT_ACCESS_TOKEN_TTL=15
# Refresh-Token Lebensdauer in Stunden
JWT_REFRESH_TOKEN_TTL=168

# --- Allgemein ---
# Umgebung: development, staging, production
APP_ENV=development
# Log-Level fuer Go-Services: debug, info, warn, error
LOG_LEVEL=debug
# Base-URL fuer die Anwendung
BASE_URL=http://localhost:3000

# --- Frontend (Vite) ---
# API-Base-URL fuer das Frontend
VITE_API_URL=http://localhost:8080
